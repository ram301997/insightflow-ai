AZURE_SQL_SERVER=YOUR-SERVER.database.windows.net
AZURE_SQL_DATABASE=YOUR-DATABASE

# Choose one non-interactive SQL authentication method.
# Option A: least-privilege SQL login (the login should only have db_datareader). No Entra ID needed.
AZURE_SQL_USERNAME=
AZURE_SQL_PASSWORD=

# Option B: Microsoft Entra service principal, also used for Foundry below.
AZURE_TENANT_ID=YOUR-TENANT-ID
AZURE_CLIENT_ID=YOUR-APPLICATION-CLIENT-ID
AZURE_CLIENT_SECRET=YOUR-CLIENT-SECRET

FOUNDRY_MODEL=YOUR-MODEL-DEPLOYMENT

# Choose one non-interactive Foundry authentication method.
# Option A: API key + direct Azure OpenAI endpoint, from the Foundry resource's "Keys and Endpoint"
# page. No Entra ID app registration needed — works even without permission to register apps.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=

# Option B: Foundry project endpoint + the Entra service principal above.
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT

# Optional: comma-separated columns the agent (and the schema/sample-row explorer tools) must never
# see or query. "ColumnName" blocks it on every table; "Table.ColumnName" blocks it on one table only.
# Example: SENSITIVE_COLUMNS=SSN,CreditCardNumber,DimCustomer.Email
SENSITIVE_COLUMNS=
